INTERLIS 2.4;

MODEL P42Target (en) AT "https://example.org" VERSION "2026-11-21" =
  TOPIC Data =
    CLASS Site =
      Name : MANDATORY TEXT*40;
    END Site;

    CLASS Route =
      Name : MANDATORY TEXT*40;
    END Route;

    CLASS PointerBase (ABSTRACT) =
      Destination : MANDATORY REFERENCE TO Site;
    END PointerBase;

    CLASS Pointer EXTENDS PointerBase =
      RemoteSite : REFERENCE TO (EXTERNAL) Site;
    END Pointer;

    ASSOCIATION Identified (OID) =
      IdentifiedSite -- {0..*} Site;
      IdentifiedRoute -- {0..*} Route;
      Note : MANDATORY TEXT*40;
    END Identified;

    ASSOCIATION Anonymous =
      AnonymousSite -- {0..*} Site;
      AnonymousRoute -- {0..*} Route;
      Note : MANDATORY TEXT*40;
    END Anonymous;

    ASSOCIATION Manual =
      RenamedSite -- {0..*} Site;
      ManualRoute -- {0..*} Route;
    END Manual;

    VIEW SiteRoutes
      JOIN OF Site, Route;
      =
    END SiteRoutes;

    ASSOCIATION Computed
      DERIVED FROM SiteRoutes =
      ComputedSite -- {0..*} Site := SiteRoutes->Site;
      ComputedRoute -- {0..*} Route := SiteRoutes->Route;
    END Computed;

    ASSOCIATION Embedded =
      EmbeddedSite -- {0..1} Site;
      EmbeddedRoute -- {0..*} Route;
    END Embedded;
  END Data;
END P42Target.
